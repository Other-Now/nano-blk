# Needed by every nano-blk test kernel (merged on top of the arch defconfig).
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_DEBUG_FS=y
CONFIG_KUNIT=y
CONFIG_KUNIT_DEBUGFS=y
CONFIG_MEMCG=y
CONFIG_CGROUPS=y
CONFIG_BLK_CGROUP=y
CONFIG_PERF_EVENTS=y
# In-tree RAM disks used as baselines
CONFIG_BLK_DEV_RAM=m
CONFIG_BLK_DEV_NULL_BLK=m
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# Keep build time down
CONFIG_DRM=n
CONFIG_SOUND=n
CONFIG_WLAN=n
CONFIG_WIRELESS=n
CONFIG_USB_SUPPORT=n
CONFIG_DEBUG_INFO_NONE=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=n
CONFIG_DEBUG_INFO_BTF=n
